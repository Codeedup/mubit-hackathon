+.ledger td { padding: 9px 14px 9px 0; border-bottom: 1px solid var(--rule-soft); white-space: nowrap; }
+.ledger td small { color: var(--steel); }
+.tag-match { color: var(--ok); font-weight: 500; }
+.tag-miss { color: var(--miss); font-weight: 500; }
+.scores { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
+.scores li { display: grid; grid-template-columns: minmax(160px, 240px) 1fr 90px; gap: 18px; align-items: center; }
+.score-name small { display: block; color: var(--steel); font-size: 13px; }
