+.score-figure { font-family: var(--narrow); font-weight: 600; font-size: 26px; text-align: right; line-height: 1; }
+.score-figure small { display: block; font-family: var(--sans); font-weight: 400; font-size: 13px; color: var(--steel); }
+.footnote { margin: 16px 0 0; font-size: 14px; color: var(--steel); }
+
+/* Narrower benches */
+@media (max-width: 1180px) {
+  .bench { grid-template-columns: 210px minmax(0, 1fr); }
+  .diagnosis-sheet { grid-column: 2; position: static; max-height: none; }
+  .flow { grid-template-columns: repeat(3, 1fr); row-gap: 20px; }
