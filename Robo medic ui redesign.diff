+/*
+  Robo Medic, night-shift service bench.
+  The incident is the printout on the bench; the model writes on it in blue pen and
+  marks what it relied on with a highlighter. Technician outcomes are green or red.
+*/
+:root {
+  --bench: #e3e7e9;
+  --sheet: #fbfcfc;
+  --sheet-pen: #f3f5fc;
+  --ink: #1d262b;
+  --steel: #5c6b73;
+  --rule: #cdd4d8;
+  --rule-soft: #e4e9eb;
+  --highlight: #f6d84a;
+  --highlight-ink: #1d262b;
+  --pen: #2b44b0;
+  --pen-soft: #e3e8fa;
+  --ok: #2c7a4e;
+  --ok-soft: #e2f1e8;
+  --miss: #b5402e;
+  --miss-soft: #f8e5e1;
 
+  --sans: "Barlow", "Segoe UI", system-ui, sans-serif;
+  --narrow: "Barlow Condensed", "Arial Narrow", "Barlow", sans-serif;
+  --code: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
+
+  color-scheme: light;
+  font-family: var(--sans);
+  font-size: 16px;
+  line-height: 1.45;
+  color: var(--ink);
+  background: var(--bench);
+  -webkit-font-smoothing: antialiased;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Night shift: the same bench under a work lamp. */
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme="light"]) {
+    --bench: #121719;
+    --sheet: #1b2226;
+    --sheet-pen: #1c2233;
+    --ink: #e4eaec;
+    --steel: #93a1a8;
+    --rule: #323d43;
+    --rule-soft: #262f34;
+    --highlight: #d9bd2c;
+    --highlight-ink: #14181a;
+    --pen: #93a6ff;
+    --pen-soft: #262f52;
+    --ok: #6cc795;
+    --ok-soft: #1c3226;
+    --miss: #f08a76;
+    --miss-soft: #3a211c;
+    color-scheme: dark;
+  }
+}
+:root[data-theme="dark"] {
+  --bench: #121719; --sheet: #1b2226; --sheet-pen: #1c2233; --ink: #e4eaec; --steel: #93a1a8;
+  --rule: #323d43; --rule-soft: #262f34; --highlight: #d9bd2c; --highlight-ink: #14181a;
+  --pen: #93a6ff; --pen-soft: #262f52; --ok: #6cc795; --ok-soft: #1c3226; --miss: #f08a76; --miss-soft: #3a211c;
+  color-scheme: dark;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 320px; background: var(--bench); color: var(--ink); }
+button, input, textarea { font: inherit; color: inherit; }
+code { font-family: var(--code); font-size: 0.82em; }
+:focus-visible { outline: 2px solid var(--pen); outline-offset: 2px; }
+.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+.quiet { color: var(--steel); }
+
+/* Masthead */
+.masthead {
+  display: flex; align-items: center; gap: 28px; flex-wrap: wrap;
+  padding: 10px 24px; border-bottom: 1px solid var(--rule); background: var(--bench);
+  position: sticky; top: 0; z-index: 5;
+}
+.brand { display: flex; align-items: center; gap: 10px; font-family: var(--narrow); font-weight: 600; font-size: 22px; letter-spacing: 0.01em; }
+.brand-mark-bg { fill: var(--ink); }
+.brand-mark-trace { fill: none; stroke: var(--highlight); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
+.views { display: flex; gap: 4px; }
+.views button {
+  border: 0; background: none; padding: 8px 12px; border-radius: 6px; cursor: pointer;
+  font-weight: 500; color: var(--steel);
+}
+.views button:hover { color: var(--ink); background: var(--rule-soft); }
+.views button.on { color: var(--ink); background: var(--sheet); box-shadow: inset 0 0 0 1px var(--rule); }
+.signals { margin-left: auto; display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; color: var(--steel); }
+.signal { display: inline-flex; align-items: center; gap: 7px; }
+.signal::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--rule); }
+.provider-mubit { color: var(--pen); }
+.provider-mubit::before { background: var(--pen); }
+.provider-local_fixture::before, .provider-missing_credentials::before, .provider-not_configured::before { background: var(--miss); }
+.sim-on::before { background: var(--ok); animation: blink 2s steps(1) infinite; }
+
+@keyframes blink { 50% { opacity: 0.25; } }
+
+/* Notices */
+.notice { border-radius: 6px; padding: 12px 14px; font-size: 15px; }
+.notice p { margin: 4px 0 0; overflow-wrap: anywhere; }
+.notice-error { background: var(--miss-soft); color: var(--miss); }
+.page-notice { margin: 16px 24px 0; }
+.capture-strip {
+  display: flex; align-items: center; gap: 14px; justify-content: space-between;
+  margin: 12px 24px 0; padding: 8px 8px 8px 14px; border-radius: 6px;
+  background: var(--highlight); color: var(--highlight-ink); font-size: 15px;
+}
+
+/* Buttons */
+.btn {
+  border: 1px solid transparent; border-radius: 6px; padding: 10px 16px; cursor: pointer;
+  font-weight: 600; font-size: 15px; line-height: 1.2;
+}
+.btn:disabled { opacity: 0.45; cursor: not-allowed; }
+.btn-primary { background: var(--pen); color: var(--sheet); }
+.btn-primary:hover:not(:disabled) { filter: brightness(1.12); }
+.btn-quiet { background: transparent; border-color: var(--rule); }
+.btn-quiet:hover:not(:disabled) { background: var(--rule-soft); }
+.btn-small { padding: 6px 12px; font-size: 14px; background: var(--highlight-ink); color: var(--highlight); }
+.link-btn { border: 0; background: none; padding: 0; color: var(--pen); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
+
+/* Bench layout: queue, printout, annotation */
+.bench {
+  display: grid; grid-template-columns: 236px minmax(0, 1.1fr) minmax(340px, 0.9fr);
+  gap: 20px; padding: 20px 24px 48px; align-items: start; max-width: 1560px; margin: 0 auto;
+}
+.loading { grid-column: 1 / -1; }
+.bench-empty { grid-column: 1 / -1; max-width: 46ch; padding: 60px 0; }
+.bench-empty h1 { font-family: var(--narrow); font-weight: 600; font-size: 34px; margin: 0 0 8px; }
+
+.sheet {
+  background: var(--sheet); border-radius: 4px; padding: 22px 24px 24px;
+  box-shadow: 0 1px 0 var(--rule), 0 0 0 1px var(--rule-soft);
+}
+
+/* Queue */
+.queue { position: sticky; top: 72px; max-height: calc(100vh - 92px); overflow-y: auto; padding-right: 4px; }
+.queue-group + .queue-group { margin-top: 20px; }
+.queue h2 {
+  display: flex; justify-content: space-between; margin: 0 0 6px; padding: 0 8px;
+  font-size: 14px; font-weight: 600; color: var(--steel);
+}
+.queue h2 span { font-weight: 400; }
+.queue ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
+.queue-item {
+  width: 100%; text-align: left; border: 0; background: none; cursor: pointer;
+  display: grid; grid-template-columns: 1fr auto; gap: 1px 8px; padding: 8px; border-radius: 5px;
+}
+.queue-item:hover { background: var(--rule-soft); }
+.queue-item.selected { background: var(--sheet); box-shadow: inset 3px 0 0 var(--ink), 0 0 0 1px var(--rule-soft); }
+.queue-title { font-weight: 500; font-size: 15px; line-height: 1.25; }
+.queue-id { grid-column: 1; font-family: var(--code); font-size: 11.5px; color: var(--steel); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.queue-status { grid-column: 1 / -1; font-size: 13px; color: var(--steel); }
+.status-diagnosed { color: var(--pen); }
+.status-confirmed-match { color: var(--ok); }
+.status-confirmed-miss { color: var(--miss); }
+.queue-item.fresh .queue-status.status-new { color: var(--highlight-ink); background: var(--highlight); justify-self: start; padding: 0 6px; border-radius: 3px; }
+
+/* Incident printout */
+.incident-sheet { min-width: 0; }
+.sheet-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; font-size: 14px; color: var(--steel); }
+.case-id { font-family: var(--code); font-size: 13px; color: var(--ink); }
+.source { font-size: 13px; padding: 1px 7px; border-radius: 3px; background: var(--rule-soft); }
+.incident-action { font-family: var(--narrow); font-weight: 600; font-size: 34px; line-height: 1.08; letter-spacing: -0.005em; margin: 14px 0 4px; }
+.time-window { margin: 0; font-size: 13px; color: var(--steel); font-family: var(--code); }
+.symptom { margin: 18px 0 0; padding: 0 0 0 14px; border-left: 3px solid var(--rule); font-size: 17px; max-width: 62ch; }
+.fault-codes { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
+.fault-code { font-family: var(--code); font-size: 13px; padding: 4px 8px; border: 1px solid var(--rule); border-radius: 3px; }
+.fault-code small { margin-left: 8px; color: var(--steel); }
+
+.channel-wrap { margin-top: 24px; overflow-x: auto; }
+.channels { width: 100%; border-collapse: collapse; font-size: 15px; }
+.channels caption { text-align: left; font-size: 14px; color: var(--steel); padding-bottom: 8px; }
+.channels th, .channels td { padding: 7px 10px 7px 0; border-bottom: 1px solid var(--rule-soft); vertical-align: baseline; }
