+}
+@media (max-width: 760px) {
+  .masthead { gap: 8px 16px; padding: 10px 16px; position: static; }
+  .signals { margin-left: 0; width: 100%; font-size: 13px; }
+  .bench { grid-template-columns: minmax(0, 1fr); padding: 12px 16px 40px; gap: 14px; }
+  .queue { min-width: 0; }
+  .channels .trace-col { display: none; }
+  .diagnosis-sheet { grid-column: auto; }
+  .queue { position: static; max-height: none; overflow: visible; display: flex; gap: 12px; overflow-x: auto; padding-bottom: 4px; }
+  .queue-group { flex: none; }
+  .queue-group + .queue-group { margin-top: 0; }
+  .queue ul { display: flex; gap: 6px; }
+  .queue-item { width: 168px; height: 100%; background: var(--sheet); }
+  .sheet { padding: 18px 16px 20px; }
+  .incident-action { font-size: 28px; }
+  .cause { font-size: 34px; }
+  .two-up, .cause-choices { grid-template-columns: 1fr; }
+  .two-up > div + div { margin-top: 4px; }
+  .capture-strip, .page-notice { margin: 12px 16px 0; }
+  .loop-main { padding: 20px 16px 40px; }
+  .flow { grid-template-columns: 1fr; }
+  .flow li, .flow li + li { padding: 14px 0 14px; }
+  .flow li + li::before { display: none; }
+  .scores li { grid-template-columns: 1fr 70px; gap: 6px 12px; }
+  .score-bar { grid-column: 1 / -1; grid-row: 2; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation: none !important; transition: none !important; }
+}
