# Local backend settings. Copy to .env only if you need to override defaults.
ROBO_MEDIC_DB_PATH=backend/robo_medic.sqlite3
ROBO_MEDIC_INCIDENT_DIR=data/incidents
ROBO_MEDIC_CORS_ORIGIN=http://localhost:5173
ROBO_MEDIC_SIMULATOR_URL=http://127.0.0.1:8001
# The offline demo works immediately. Choose mubit for live classification.
ROBO_MEDIC_PROVIDER=local_fixture

# Server-side Mubit inference settings. Never add these to frontend environment files.
MUBIT_API_KEY=
MUBIT_API_FORMAT=gemini
MUBIT_MODEL=gemini-3.8-flash
MUBIT_BASE_URL=https://api.mubit.ai/gemini

# DeepSeek directly through OpenRouter: set ROBO_MEDIC_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# DeepSeek through Mubit: set provider=mubit and change all three below:
# MUBIT_API_FORMAT=openai
# MUBIT_BASE_URL=https://api.mubit.ai/compat/openrouter/v1
# MUBIT_MODEL=deepseek/deepseek-v4.1-flash-1017
# Use your Mubit inference key above; save the OpenRouter key in Mubit.

# Optional live task status and reviewed outcome submission. No automatic training.
# Use a project-scoped management key: read for status, member for feedback.
MUBIT_MANAGEMENT_KEY=
MUBIT_MANAGEMENT_URL=https://api.mubit.ai
MUBIT_PROJECT_ID=
MUBIT_TASK_ID=

