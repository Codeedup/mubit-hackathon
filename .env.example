# Local backend settings. Copy to .env only if you need to override defaults.
ROBO_MEDIC_DB_PATH=backend/robo_medic.sqlite3
ROBO_MEDIC_INCIDENT_DIR=data/incidents
ROBO_MEDIC_CORS_ORIGIN=http://localhost:5173
ROBO_MEDIC_SIMULATOR_URL=http://127.0.0.1:8001
# unavailable (default), local_fixture for an offline demo, or mubit for live diagnosis.
ROBO_MEDIC_PROVIDER=unavailable

# Server-side Mubit inference settings. Never add these to frontend environment files.
MUBIT_API_KEY=
MUBIT_MODEL=gemini-3.8-flash
MUBIT_BASE_URL=https://api.mubit.ai/gemini

